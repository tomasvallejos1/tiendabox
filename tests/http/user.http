### TiendaBox - Pruebas del recurso User
### Nota: estas rutas no requieren autenticacion actualmente
### (ver src/user/user.routes.ts, montadas sin guards en app.ts).

@host = http://localhost:3000
@userEmail = nuevo@example.com

### 1. Crear usuario -> 201 Created
# Si ya se ejecuto antes, el email queda ocupado (ver caso 2, 409 Conflict).
# Para volver a probar un alta limpia, cambia @userEmail arriba.
# @name createUser
POST {{host}}/api/user
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "secreto123",
  "role": "cliente"
}

### 2. Crear usuario con email duplicado -> 409 Conflict
POST {{host}}/api/user
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "secreto123"
}

### 3. Crear usuario con password corta -> 400 Bad Request
POST {{host}}/api/user
Content-Type: application/json

{
  "email": "otro@example.com",
  "password": "123"
}

### 4. Crear usuario con role invalido -> 400 Bad Request
POST {{host}}/api/user
Content-Type: application/json

{
  "email": "otro2@example.com",
  "password": "secreto123",
  "role": "admin"
}

### 5. Listar todos los usuarios -> 200 OK
GET {{host}}/api/users

### 6. Obtener usuario por id -> 200 OK
# Usa el id devuelto en el caso 1, sin copiar y pegar nada.
GET {{host}}/api/user/{{createUser.response.body.$.id}}

### 7. Obtener usuario inexistente -> 404 Not Found
GET {{host}}/api/user/00000000-0000-0000-0000-000000000000

### 8. Actualizar email del usuario -> 200 OK
PUT {{host}}/api/user/{{createUser.response.body.$.id}}
Content-Type: application/json

{
  "email": "actualizado@example.com"
}

### 9. Actualizar usuario inexistente -> 404 Not Found
PUT {{host}}/api/user/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "email": "otro@example.com"
}

### 10. Eliminar usuario -> 204 No Content
DELETE {{host}}/api/user/{{createUser.response.body.$.id}}

### 11. Eliminar de nuevo el mismo usuario -> 404 Not Found
DELETE {{host}}/api/user/{{createUser.response.body.$.id}}
