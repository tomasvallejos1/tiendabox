{
  "name": "tiendabox",
  "version": "1.0.0",
  "description": "API REST para la gestión de una tienda de productos electrónicos con catálogo, carrito y pedidos, construida con TypeScript, Express, PostgreSQL y MongoDB",
  "private": true,
  "main": "dist/init.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/init.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/sql','dist/db/sql',{recursive:true})\"",
    "start": "node dist/init.js",
    "format": "prettier --write src test",
    "lint": "eslint src test",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration --runInBand",
    "test:watch": "jest test/unit --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasvallejos1/tiendabox.git"
  },
  "keywords": [
    "api-rest",
    "typescript",
    "express",
    "nodejs",
    "postgresql",
    "mongodb",
    "ecommerce",
    "arquitectura-por-capas",
    "repository-pattern",
    "docker",
    "utn"
  ],
  "contributors": [
    "Tomás Vallejos",
    "Lautaro Landriel",
    "Pedro Borda Bossana"
  ],
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/tomasvallejos1/tiendabox/issues"
  },
  "homepage": "https://github.com/tomasvallejos1/tiendabox#readme",
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "mongodb": "^6.21.0",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1"
  }
}
